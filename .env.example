# Optional settings for the local Docker stack (compose.yaml). Copy to .env (gitignored); never commit values.
# Base64 of 32+ random bytes (JwtOptions.TryDecodeKey), e.g. `openssl rand -base64 32`. Set it so sessions survive an api restart; empty = ephemeral Development key.
JWT_SIGNING_KEY=
# Both set = the first admin is created on startup; empty = skipped.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Stripe TEST mode only (sk_test_ / pk_test_ from the Stripe dashboard, test mode). Empty = checkout answers 503.
# The webhook secret is the whsec_ value printed by: stripe listen --forward-to localhost:5081/api/v1/webhooks/stripe
# Changing the publishable key needs a web rebuild (Expo inlines it at build time).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
