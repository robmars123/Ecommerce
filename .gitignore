# =============================================================================
# Ecommerce — .gitignore
# Stack (see docs/ecommerce-architecture.md):
#   Backend : ASP.NET Core (.NET 10) modular monolith  -> backend/src/, backend/tests/
#   Frontend: Expo + React Native + RN Web (TypeScript) -> frontend/apps/store/
#   Infra   : Docker, GitHub Actions, EAS cloud builds, DigitalOcean
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — "No secrets in git" (architecture invariant #10)
# Stripe keys, webhook secrets, DB/Redis connection strings, JWT signing keys,
# S3/Spaces credentials live in env vars / user-secrets / secret manager only.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.local.json
appsettings.*.local.json
secrets.json
*.pfx
*.p12
*.pem
*.key
*.snk
*.publishsettings
*.pubxml
*.pubxml.user
PublishScripts/

# Mobile signing material (EAS manages credentials in the cloud)
*.jks
*.keystore
*.p8
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist

# -----------------------------------------------------------------------------
# .NET — build output, NuGet, tests, coverage
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
x64/
x86/
artifacts/
publish/

*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

# Test results & coverage (xUnit, Testcontainers, Coverlet)
[Tt]est[Rr]esult*/
TestResult.xml
*.trx
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
coverage/
coveragereport/
BenchmarkDotNet.Artifacts/

# Logs (Serilog file sinks, MSBuild)
[Ll]og/
[Ll]ogs/
*.log
*.binlog
*.svclog

# -----------------------------------------------------------------------------
# Expo / React Native / Node — frontend/apps/store/
# -----------------------------------------------------------------------------
node_modules/
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Native folders are generated by EAS Build in the cloud — never commit them
frontend/apps/store/android/
frontend/apps/store/ios/
*.apk
*.aab
*.ipa

npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/releases

# -----------------------------------------------------------------------------
# Local infrastructure (Docker volumes, local DB dumps)
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker-data/
*.dump
*.backup
*.mdf
*.ldf

# -----------------------------------------------------------------------------
# IDE & editor
# -----------------------------------------------------------------------------
.vs/
.idea/
*.DotSettings.user
_ReSharper*/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.localhistory/
*.swp
*~

# Claude Code — keep shared settings, ignore personal overrides
.claude/settings.local.json

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
