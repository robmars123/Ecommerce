{
  "name": "store",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@microsoft/signalr": "10.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.1",
    "@stripe/stripe-react-native": "0.81.0",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.24",
    "expo-constants": "58.0.16",
    "expo-crypto": "58.0.8",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "tailwindcss": "3.4.19",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "setupFiles": [
          "<rootDir>/tests/jest-setup.js"
        ],
        "moduleNameMapper": {
          "[.]css$": "<rootDir>/tests/style-stub.js",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/__rsc_tests__/",
          "<rootDir>/dist/",
          "<rootDir>/.expo/"
        ]
      },
      {
        "displayName": "android",
        "preset": "jest-expo/android",
        "setupFiles": [
          "<rootDir>/tests/jest-setup.js"
        ],
        "moduleNameMapper": {
          "[.]css$": "<rootDir>/tests/style-stub.js",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/__rsc_tests__/",
          "<rootDir>/dist/",
          "<rootDir>/.expo/"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "setupFiles": [
          "<rootDir>/tests/jest-setup.js"
        ],
        "moduleNameMapper": {
          "[.]css$": "<rootDir>/tests/style-stub.js",
          "^@/(.*)$": "<rootDir>/$1"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/__rsc_tests__/",
          "<rootDir>/dist/",
          "<rootDir>/.expo/"
        ],
        "testMatch": [
          "**/?(*.)+(spec|test).web.[jt]s?(x)"
        ]
      }
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "features/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ]
  }
}
