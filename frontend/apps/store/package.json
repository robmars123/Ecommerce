{
  "name": "store",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/dist/",
      "<rootDir>/.expo/"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "features/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ]
  }
}
