# Copy to .env.local (gitignored). Expo inlines EXPO_PUBLIC_* values at build time.
# Local API (launchSettings port). On a phone with Expo Go, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5080
# Publishable key of the payment provider, test mode (public by design; never put a secret key here). Empty = the payment step shows a configuration error.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
