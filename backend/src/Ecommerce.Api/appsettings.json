{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "Images": {
      "BaseUrl": "",
      "Storage": {
        "ServiceUrl": "",
        "Region": "",
        "Bucket": "",
        "AccessKeyId": "",
        "SecretAccessKey": ""
      }
    },
    "DevSeed": {
      "Enabled": false
    }
  },
  "Shipping": {
    "Carriers": [],
    "Methods": [],
    "Countries": []
  },
  "Tax": {
    "RatePercent": 0
  },
  "Checkout": {
    "ReservationTtlMinutes": 15
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "Cart": {
    "MaxQuantityPerLine": 10
  },
  "Store": {
    "Currency": "USD"
  },
  "Inventory": {
    "LowStockThreshold": 5,
    "ReservationSweepSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Identity": {
    "Jwt": {
      "Issuer": "ecommerce-api",
      "Audience": "ecommerce-store",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "RefreshTokens": {
      "SlidingLifetimeDays": 14,
      "AbsoluteLifetimeDays": 30,
      "Cookie": {
        "Name": "ecommerce_rt",
        "Secure": true
      }
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "DurationMinutes": 5
    },
    "PasswordReset": {
      "TokenLifetimeMinutes": 30,
      "LinkBaseUrl": "",
      "DevPickupDirectory": ""
    },
    "Bootstrap": {
      "AdminEmail": "",
      "AdminPassword": ""
    }
  }
}
