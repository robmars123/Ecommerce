{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "Images": {
      "BaseUrl": ""
    },
    "DevSeed": {
      "Enabled": false
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Identity": {
    "Jwt": {
      "Issuer": "ecommerce-api",
      "Audience": "ecommerce-store",
      "SigningKey": "",
      "AccessTokenMinutes": 15
    },
    "RefreshTokens": {
      "SlidingLifetimeDays": 14,
      "AbsoluteLifetimeDays": 30,
      "Cookie": {
        "Name": "ecommerce_rt",
        "Secure": true
      }
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "DurationMinutes": 5
    },
    "PasswordReset": {
      "TokenLifetimeMinutes": 30,
      "LinkBaseUrl": "",
      "DevPickupDirectory": ""
    },
    "Bootstrap": {
      "AdminEmail": "",
      "AdminPassword": ""
    }
  }
}
